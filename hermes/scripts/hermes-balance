#!/usr/bin/env python3
"""Fetch Hermes (DeepSeek) balance + local token usage.

Reads DEEPSEEK_API_KEY from ~/.hermes/.env (never prints the key).
Queries https://api.deepseek.com/user/balance
Sums tokens from ~/.hermes/state.db for today/month.

Prints one JSON object to stdout.
"""
from __future__ import annotations

import json
import os
import sqlite3
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


def hermes_home() -> Path:
    return Path(os.environ.get("HERMES_HOME", "~/.hermes")).expanduser()


def load_deepseek_key() -> str:
    env_path = hermes_home() / ".env"
    if not env_path.exists():
        raise SystemExit("no_env")
    for line in env_path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        if k.strip() == "DEEPSEEK_API_KEY":
            key = v.strip().strip('"').strip("'")
            if key:
                return key
    raise SystemExit("no_key")


def fetch_balance(key: str) -> dict:
    req = urllib.request.Request(
        "https://api.deepseek.com/user/balance",
        headers={
            "Authorization": f"Bearer {key}",
            "Accept": "application/json",
            "User-Agent": "hermes-balance/1.0",
        },
    )
    with urllib.request.urlopen(req, timeout=12) as resp:
        return json.loads(resp.read().decode("utf-8"))


def parse_balance(data: dict) -> dict:
    """Return total_balance (float CNY preferred), currency, is_available."""
    infos = data.get("balance_infos") if isinstance(data, dict) else None
    if not isinstance(infos, list) or not infos:
        return {
            "is_available": bool(data.get("is_available")) if isinstance(data, dict) else False,
            "balance": None,
            "currency": None,
            "granted_balance": None,
            "topped_up_balance": None,
        }
    # Prefer CNY, else first
    pick = None
    for info in infos:
        if isinstance(info, dict) and info.get("currency") == "CNY":
            pick = info
            break
    if pick is None:
        pick = infos[0] if isinstance(infos[0], dict) else {}
    def fnum(x):
        try:
            return float(x)
        except (TypeError, ValueError):
            return None
    return {
        "is_available": bool(data.get("is_available")),
        "balance": fnum(pick.get("total_balance")),
        "currency": pick.get("currency") or "CNY",
        "granted_balance": fnum(pick.get("granted_balance")),
        "topped_up_balance": fnum(pick.get("topped_up_balance")),
    }


def to_ts(s) -> float | None:
    if s is None:
        return None
    if isinstance(s, (int, float)):
        return float(s)
    s = str(s)
    try:
        if s.replace(".", "", 1).isdigit():
            return float(s)
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def local_token_stats() -> dict:
    db = hermes_home() / "state.db"
    if not db.exists():
        return {"tokens_today": 0, "tokens_month": 0, "busy": False, "model": None}
    now = datetime.now().astimezone()
    start_day = now.replace(hour=0, minute=0, second=0, microsecond=0)
    start_month = start_day.replace(day=1)
    day_ts = start_day.timestamp()
    month_ts = start_month.timestamp()
    today = month = 0
    busy = False
    model = None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        for row in con.execute(
            "SELECT started_at, last_activity_at, input_tokens, output_tokens, model, ended_at "
            "FROM sessions"
        ):
            ts = to_ts(row[1] or row[0])
            if ts is None:
                continue
            tot = int(row[2] or 0) + int(row[3] or 0)
            if ts >= month_ts:
                month += tot
                if ts >= day_ts:
                    today += tot
            # Busy: open session with activity in last 90s
            if row[5] is None and ts >= time.time() - 90:
                busy = True
            if model is None and row[4]:
                model = row[4]
        # Prefer most recent model
        row = con.execute(
            "SELECT model FROM sessions WHERE model IS NOT NULL ORDER BY last_activity_at DESC LIMIT 1"
        ).fetchone()
        if row and row[0]:
            model = row[0]
    except Exception:
        pass
    return {
        "tokens_today": today,
        "tokens_month": month,
        "busy": busy,
        "model": model,
    }


def main() -> int:
    try:
        key = load_deepseek_key()
    except SystemExit as e:
        out = {
            "error": str(e),
            "balance": None,
            "currency": "CNY",
            "tokens_today": 0,
            "tokens_month": 0,
            "busy": False,
        }
        local = local_token_stats()
        out.update(local)
        sys.stdout.write(json.dumps(out, separators=(",", ":")))
        sys.stdout.write("\n")
        return 0

    local = local_token_stats()
    try:
        raw = fetch_balance(key)
        bal = parse_balance(raw)
        out = {
            "error": None,
            "balance": bal["balance"],
            "currency": bal["currency"],
            "granted_balance": bal["granted_balance"],
            "topped_up_balance": bal["topped_up_balance"],
            "is_available": bal["is_available"],
            "from_cache": False,
            "fetched_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            **local,
        }
    except urllib.error.HTTPError as exc:
        out = {
            "error": f"HTTP {exc.code}",
            "balance": None,
            "currency": "CNY",
            **local,
        }
    except Exception as exc:
        out = {
            "error": str(exc)[:120],
            "balance": None,
            "currency": "CNY",
            **local,
        }
    sys.stdout.write(json.dumps(out, separators=(",", ":")))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
